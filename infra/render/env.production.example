# Production environment for apothem-api on Render. Copy the names, never the placeholder values.
# Real values live only in the Render dashboard (and a password manager), never in this repository.
# `src/infrastructure/http/deploy-config.test.ts` keeps this file, render.yaml and the code in agreement.

NODE_ENV=production

# Supabase Postgres through the TRANSACTION pooler (port 6543), with SSL. Prepared statements must be off
# for a transaction pooler (ADR-010).
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_PREPARED_STATEMENTS=false
# A free Supabase project allows few connections: keep the pool small.
DATABASE_POOL_MAX=5

# Signed bearer tokens only. Production refuses AUTH_MODE=dev.
AUTH_MODE=jwt
AUTH_JWT_ISSUER=https://app.apothemai.com.br
AUTH_JWT_AUDIENCE=apothem-api
# At least 32 random characters. The web app signs the short-lived API token with the same value
# (APOTHEM_API_TOKEN_SECRET on Vercel) and must use the same issuer and audience.
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Create the account on the first login of a provider-verified email. An account alone grants no access.
AUTH_JIT_PROVISIONING=true

# Optional. Leave unset to keep the deterministic mock model (no cost, no provider).
# ANTHROPIC_API_KEY=
