# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=3001

# PostgreSQL (Docker Compose default — see infra/docker/docker-compose.yml)
DATABASE_URL=postgres://apothem:apothem@localhost:5432/apothem

# Redis (Docker Compose default)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO, S3-compatible — Docker Compose default)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=apothem
STORAGE_SECRET_ACCESS_KEY=apothem123
STORAGE_BUCKET=apothem-dev

# Auth (self-hosted OIDC — see docs/adr/009-zero-cost-initial-stack.md)
AUTH_SECRET=replace-with-a-long-random-value

# dev: trust the x-principal-id header (local only; the API refuses to boot in production with it).
# jwt: verify signed bearer tokens. Production must use jwt. Needs issuer and audience, and either
# an AUTH_SECRET of at least 32 characters (HS256) or AUTH_JWKS_URL (RS256/ES256 from your OIDC provider).
AUTH_MODE=dev
# AUTH_JWT_ISSUER=https://auth.apothemai.com.br
# AUTH_JWT_AUDIENCE=apothem-api
# AUTH_JWKS_URL=https://auth.apothemai.com.br/.well-known/jwks.json

# AI providers — leave unset to force the mock Model Gateway adapter in dev/CI
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
