# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=3001

# PostgreSQL (Docker Compose default — see infra/docker/docker-compose.yml)
DATABASE_URL=postgres://apothem:apothem@localhost:5432/apothem

# Redis (Docker Compose default)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO, S3-compatible — Docker Compose default)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=apothem
STORAGE_SECRET_ACCESS_KEY=apothem123
STORAGE_BUCKET=apothem-dev

# Auth (self-hosted OIDC — see docs/adr/009-zero-cost-initial-stack.md)
AUTH_SECRET=replace-with-a-long-random-value

# AI providers — leave unset to force the mock Model Gateway adapter in dev/CI
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
