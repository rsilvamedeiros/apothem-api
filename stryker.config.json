{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": ".stryker-cache/incremental.json",
  "mutate": [
    "src/modules/authorization/**/*.ts",
    "src/modules/agents/application/*.ts",
    "src/modules/models/application/*.ts",
    "src/modules/audit/application/*.ts",
    "src/modules/runs/application/run.service.ts",
    "src/modules/approvals/application/approval.service.ts",
    "src/modules/tools/domain/*.ts",
    "src/modules/knowledge/domain/*.ts",
    "src/modules/knowledge/application/knowledge.service.ts",
    "src/modules/knowledge/application/knowledge-retriever.ts",
    "src/modules/tools/application/tool-executor.ts",
    "src/modules/tools/application/tool-policy.service.ts",
    "src/modules/runs/domain/*.ts",
    "src/modules/agents/domain/*.ts",
    "src/common/keyset-cursor.ts",
    "src/modules/organizations/application/*.ts",
    "src/modules/identity/infrastructure/jwt-authenticator.ts",
    "src/infrastructure/http/tenant-context.middleware.ts",
    "src/infrastructure/http/build-authenticator.ts",
    "!src/**/*.test.ts",
    "!src/**/*.port.ts",
    "!src/modules/authorization/**/__fixtures__/**"
  ],
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 90, "low": 80, "break": 75 },
  "tempDirName": ".stryker-tmp"
}
