{
  "name": "apothem-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "APOTHEM AI backend: identity, agents, knowledge, connect, flow, approvals, audit.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/infrastructure/database/migrate.ts",
    "db:seed": "tsx --env-file=.env database/seed.ts",
    "openapi:generate": "tsx --env-file=.env infra/scripts/generate-openapi.ts",
    "docs:check-links": "tsx infra/scripts/check-doc-links.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fastify/swagger": "^9.8.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "globby": "^16.2.4",
    "prettier": "^3.3.3",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
